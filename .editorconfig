# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
max_line_length = off
trim_trailing_whitespace = false

# JSON Lines holds one record per line by definition, so a record cannot be
# wrapped. docs/audit/findings/resolved.jsonl is the findings ledger.
[*.jsonl]
max_line_length = off
