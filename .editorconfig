# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
max_line_length = off
trim_trailing_whitespace = false

# The findings store is written by the nitpicker findings tool, not by hand.
# INDEX.md table rows carry each finding's title and resolved.jsonl holds one
# record per line, so neither can be wrapped. Last, so it overrides [*.md].
[docs/audit/findings/**]
max_line_length = off
